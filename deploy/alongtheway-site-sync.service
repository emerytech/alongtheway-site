[Unit]
Description=Deploy checked Along the Way static website output
After=network-online.target nginx.service
Wants=network-online.target
[Service]
Type=oneshot
User=atw-site
Group=atw-site
ExecStart=/usr/bin/python3 /usr/local/libexec/alongtheway-site-sync.py
StateDirectory=alongtheway-site
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/alongtheway-site /var/lib/alongtheway-site
InaccessiblePaths=/opt/along-the-way /etc/along-the-way /etc/cloudflared /var/lib/along-the-way /var/backups/along-the-way
RestrictSUIDSGID=yes
CapabilityBoundingSet=
TimeoutStartSec=150
